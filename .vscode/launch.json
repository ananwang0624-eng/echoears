{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎧 LIVE — binaural 233cm (two sensors, 20Hz) (60s)",
      "program": "${workspaceFolder}/apps/live.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "--odr",
        "4",
        "--odr-ms",
        "25",
        "--seconds",
        "60",
        "--wav",
        "${workspaceFolder}/out/live.wav"
      ]
    },
    {
      "name": "🎧 LIVE — binaural 233cm (unlimited, Ctrl-C stops)",
      "program": "${workspaceFolder}/apps/live.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "--odr",
        "4",
        "--odr-ms",
        "25",
        "--wav",
        "${workspaceFolder}/out/live.wav"
      ]
    },
    {
      "name": "▶ REPLAY — same pipeline from a recording (no hardware)",
      "program": "${workspaceFolder}/apps/live.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "--replay",
        "${input:npzPath}",
        "--odr",
        "${input:archiveOdr}",
        "--seconds",
        "20",
        "--wav",
        "${workspaceFolder}/out/replay.wav"
      ]
    },
    {
      "name": "🔍 SHOW — range profile of a recording",
      "program": "${workspaceFolder}/apps/show.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "${input:npzPath}",
        "--odr",
        "${input:archiveOdr}",
        "--static"
      ]
    },
    {
      "name": "📐 QUEUE — install the 233cm queue",
      "program": "${workspaceFolder}/tools/use_queue.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "set",
        "${env:HOME}/Documents/GitHub/ultrasonic/firmware/txrot/txrot_long233.json"
      ]
    },
    {
      "name": "📐 QUEUE — status (which one is active)",
      "program": "${workspaceFolder}/tools/use_queue.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "status"
      ]
    },
    {
      "name": "📐 QUEUE — plan any range",
      "program": "${workspaceFolder}/tools/measqueue.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "plan",
        "--range-cm",
        "${input:rangeCm}"
      ]
    },
    {
      "name": "↩️  QUEUE — restore (undo the upstream edit)",
      "program": "${workspaceFolder}/tools/use_queue.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": [
        "restore"
      ]
    },
    {
      "name": "✅ TEST — unit tests",
      "module": "pytest",
      "args": [
        "tests/",
        "-v"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "▶ RUN CURRENT FILE (py39)",
      "program": "${file}",
      "type": "debugpy",
      "request": "launch",
      "python": "${env:HOME}/Documents/GitHub/ultrasonic/.venv-py39/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "npzPath",
      "type": "promptString",
      "description": "recording npz path",
      "default": "${env:HOME}/Documents/GitHub/ultrasonic/matrix/data/m3x3_txrot_odr13/hand_moving/txrot_20260719_174149.npz"
    },
    {
      "id": "archiveOdr",
      "type": "pickString",
      "description": "CIC ODR of the recording",
      "options": [
        "6",
        "4",
        "5",
        "3"
      ],
      "default": "6"
    },
    {
      "id": "rangeCm",
      "type": "promptString",
      "description": "target range in cm",
      "default": "120"
    }
  ]
}
